## Frontend Component Contracts

### Dashboard Layout Interface
```typescript
interface DashboardLayoutProps {
  children: ReactNode;
  sidebarCollapsed?: boolean;
  theme?: 'dark' | 'light' | 'futuristic-dark';
}

interface DashboardLayoutState {
  sidebarCollapsed: boolean;
  currentView: 'tasks' | 'calendar' | 'analytics';
  theme: 'dark' | 'light' | 'futuristic-dark';
}
```

### Glassmorphic Component Interface
```typescript
interface GlassmorphicProps {
  children: ReactNode;
  blurIntensity?: number; // 0-20px
  opacity?: number; // 0.1-0.8
  gradientStart?: string;
  gradientEnd?: string;
  borderOpacity?: number; // 0.1-0.3
  className?: string;
}

interface GlassmorphicState {
  isVisible: boolean;
  animationPhase: 'idle' | 'enter' | 'hover' | 'exit';
}
```

### Task Card Interface
```typescript
interface TaskCardProps {
  task: Task;
  onToggleComplete: (taskId: string) => void;
  onEdit: (task: Task) => void;
  onDelete: (taskId: string) => void;
  glassProperties?: GlassmorphicProps;
  animationState?: 'idle' | 'hover' | 'complete' | 'delete';
}

interface TaskCardState {
  isHovered: boolean;
  isAnimating: boolean;
  animationProgress: number;
}
```

### Navigation Interface
```typescript
interface NavigationItem {
  id: string;
  icon: string;
  label: string;
  href: string;
  active: boolean;
  glowEffect?: boolean;
}

interface SidebarProps {
  navigationItems: NavigationItem[];
  collapsed?: boolean;
  onCollapseToggle: () => void;
}

interface SidebarState {
  collapsed: boolean;
  activeItem: string;
  hoveredItem: string | null;
}
```

