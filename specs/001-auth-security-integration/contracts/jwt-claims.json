{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "JWT Claims Schema",
  "description": "Schema for JWT token claims in the authentication system",
  "required": ["sub", "user_id", "email", "iat", "exp"],
  "properties": {
    "sub": {
      "type": "string",
      "description": "Subject (user ID)"
    },
    "user_id": {
      "type": "string",
      "description": "User ID for authorization checks"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "User's email address"
    },
    "iat": {
      "type": "number",
      "description": "Issued at timestamp"
    },
    "exp": {
      "type": "number",
      "description": "Expiration timestamp"
    }
  }
}