from agents import Agent, Runner, AsyncOpenAI, OpenAIChatCompletionsModel, RunConfig
from dotenv import load_dotenv
import os

load_dotenv()

# ✅ Use GROQ key (NOT Gemini)
groq_api_key = os.getenv("GROQ_API_KEY")

if not groq_api_key:
    raise ValueError("GROQ_API_KEY is missing in .env")

# ✅ Groq OpenAI-compatible endpoint
client = AsyncOpenAI(
    api_key=groq_api_key,
    base_url="https://api.groq.com/openai/v1",
)

# ✅ Model
model = OpenAIChatCompletionsModel(
    model="openai/gpt-oss-20b",
    openai_client=client
)

config = RunConfig(
    model=model,
    model_provider=client,
    tracing_disabled=True
)

##########################################################
# AGENT (IMPORTANT)
##########################################################

SYSTEM_PROMPT = """
You are a Todo AI assistant.

RULES:
- ALWAYS use MCP tools to manage tasks.
- NEVER fabricate tasks.
- NEVER simulate tool usage.
- If user intent matches a tool, call it.
- Confirm actions clearly.
"""

agent = Agent(
    name="Todo-Agent",
    instructions=SYSTEM_PROMPT,
    model=model
)

##########################################################
# RUNNER
##########################################################

runner = Runner(
    agent=agent,
    run_config=config
)

##########################################################
# Example Call
##########################################################

async def run_agent(message: str):
    result = await runner.run(message)
    return result
