# Database Configuration
# Neon PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host/database?sslmode=require
# IMPORTANT: Replace with your actual Neon database credentials
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database?sslmode=require

# Database connection pool settings
# Number of connections to maintain in the pool
DATABASE_POOL_SIZE=10

# Maximum number of connections that can be created beyond pool_size
DATABASE_MAX_OVERFLOW=20

# Application Environment
# Options: development, production, test
# Controls behavior like debug mode, logging verbosity, etc.
APP_ENV=development

# Logging Configuration
# Logging level - Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Detailed information for diagnosing problems
# INFO: General informational messages
# WARNING: Warning messages for potentially harmful situations
# ERROR: Error messages for serious problems
# CRITICAL: Critical messages for very serious errors
LOG_LEVEL=INFO

# Log format - Options: json, text
# json: Structured JSON logs (recommended for production)
# text: Human-readable text logs (recommended for development)
LOG_FORMAT=json

# Optional log file path for file-based logging
# Leave empty or comment out for stdout-only logging
# Example: /var/log/todo-backend/app.log
# LOG_FILE=

# Log file rotation size (only used if LOG_FILE is set)
# Examples: "100 MB", "1 GB", "500 KB"
LOG_ROTATION=100 MB

# Log file retention period (only used if LOG_FILE is set)
# Examples: "30 days", "1 week", "90 days"
LOG_RETENTION=30 days

# API Server Configuration
# Host address for the API server
# 0.0.0.0 allows connections from any network interface
# 127.0.0.1 restricts to localhost only
API_HOST=0.0.0.0

# Port number for the API server
# Default: 8000 (standard for development)
# Production: Use reverse proxy (nginx/traefik) on port 80/443
API_PORT=8000

# Authentication Configuration
# Shared secret for JWT token signing and verification
# CRITICAL: This secret MUST match the BETTER_AUTH_SECRET in frontend/.env.local
# Used by Better Auth (frontend) to sign JWT tokens and backend to verify them
# IMPORTANT: Generate a strong random string (32+ characters recommended)
# Example generation: openssl rand -base64 32
# SECURITY: Never commit actual secret to version control, rotate regularly
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# CORS Configuration
# Frontend application URL(s) for CORS access control
# Supports single URL or comma-separated list for multiple origins
# Development: http://localhost:3000
# Production: https://app.example.com
# Multiple: http://localhost:3000,https://app.example.com
FRONTEND_URL=http://localhost:3000

# Allow credentials (cookies, authorization headers) in CORS requests
# Set to true when using JWT tokens in Authorization header
CORS_ALLOW_CREDENTIALS=true

# Maximum time (seconds) browsers can cache CORS preflight responses
# Default: 3600 (1 hour)
CORS_MAX_AGE=3600

# Security Notes:
# - Never commit .env file to version control
# - Use strong passwords for database credentials
# - Rotate credentials regularly
# - Use environment-specific .env files (.env.production, .env.test)
# - Consider using secret management tools (AWS Secrets Manager, HashiCorp Vault)

# AI Agent Configuration
# Groq API Configuration (Primary AI Provider)
# Get your API key from: https://console.groq.com/keys
# IMPORTANT: Keep this secret secure, never commit to version control
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use for AI agent
# Recommended: openai/gpt-oss-20b (200k tokens/min, 30 req/min, 1000 req/day)
# Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-20b

# Groq rate limits (for monitoring and fallback logic)
# Tokens per minute limit
GROQ_RATE_LIMIT_TPM=200000

# Requests per minute limit
GROQ_RATE_LIMIT_RPM=30

# Requests per day limit
GROQ_RATE_LIMIT_RPD=1000

# OpenAI API Configuration (Fallback Provider)
# Get your API key from: https://platform.openai.com/api-keys
# Used when Groq rate limits are exceeded
# IMPORTANT: Keep this secret secure, never commit to version control
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI model to use for fallback
# Recommended: gpt-4o-mini (cost-effective, fast)
# Other options: gpt-4o, gpt-4-turbo
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Enable automatic fallback to OpenAI when Groq fails
# Set to false to disable fallback (agent will fail on Groq errors)
OPENAI_FALLBACK_ENABLED=true

# Agent Behavior Configuration
# Temperature for AI responses (0.0 = deterministic, 1.0 = creative)
# Recommended: 0.1 for maximum determinism in task management
# Lower temperature = more consistent, predictable responses
AGENT_TEMPERATURE=0.1

# Maximum tokens in agent response
# Recommended: 500 for concise task management responses
# Shorter responses = faster, more focused interactions
AGENT_MAX_TOKENS=500

# Maximum conversation history messages to include in context
# Higher = more context but slower/more expensive
# Recommended: 20 messages (10 user + 10 assistant)
AGENT_MAX_HISTORY_MESSAGES=20

# Agent request timeout in seconds
# Maximum time to wait for AI model response
AGENT_TIMEOUT_SECONDS=30

# Retry Configuration
# Maximum number of retry attempts for transient failures
# LLM failures (rate limits, timeouts): 3 attempts
# MCP tool failures (timeouts, connection errors): 2 attempts
RETRY_MAX_ATTEMPTS_LLM=3
RETRY_MAX_ATTEMPTS_TOOL=2

# Initial delay before first retry (milliseconds)
# Exponential backoff starts from this value
RETRY_INITIAL_DELAY_MS=100

# Maximum delay between retries (milliseconds)
# Caps exponential backoff to prevent excessive wait times
RETRY_MAX_DELAY_MS=5000

# Backoff multiplier for exponential backoff
# Each retry waits: previous_delay * multiplier
# Example: 100ms → 200ms → 400ms → 800ms (capped at 5000ms)
RETRY_BACKOFF_MULTIPLIER=2.0

