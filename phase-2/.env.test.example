# Test Environment Configuration Template
# Copy this file to .env.test and fill in the values for testing

# Test Database (isolated from production)
# Use a separate test database or in-memory SQLite
TEST_DATABASE_URL="sqlite:///test.db"
# For PostgreSQL testing (Neon test instance):
# TEST_DATABASE_URL="postgresql+psycopg://user:password@ep-xyz.region.neon.tech/test_db?sslmode=require"

# JWT secret for testing (MUST be different from production)
BETTER_AUTH_SECRET="test-secret-key-for-testing-only-change-this"

# Test API configuration
TEST_API_PORT=8001
TEST_API_HOST="localhost"
TEST_API_BASE_URL="http://localhost:8001"

# Test Frontend configuration
TEST_FRONTEND_PORT=3001
TEST_FRONTEND_URL="http://localhost:3001"

# Test execution settings
TEST_TIMEOUT=30
TEST_PARALLEL_WORKERS=4

# Browser testing (Playwright)
PLAYWRIGHT_BROWSER="chromium"
PLAYWRIGHT_HEADLESS="true"
PLAYWRIGHT_SLOW_MO=0

# Test data settings
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="TestPassword123!"

# Logging
TEST_LOG_LEVEL="INFO"
